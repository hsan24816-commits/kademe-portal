# PostgreSQL connection string
DATABASE_URL=postgresql://kademe:change-me@localhost:5432/kademe
# Set to 1 if your database host requires SSL (most managed PostgreSQL services do)
DATABASE_SSL=0

PORT=3000
NODE_ENV=production
# Set to 1 when running behind a hosting proxy or load balancer (Render, Railway, nginx...)
TRUST_PROXY=1

# Name shown in the header and on the sign-in page
ORG_NAME=Kademe

# First account, created only when the database has no users yet.
# This person must choose a new password at first sign-in.
ADMIN_USERNAME=halit
ADMIN_PASSWORD=change-this-temporary-password
ADMIN_NAME="Halit Özdamar"
ADMIN_EMAIL=

# 1 shows the demo accounts on the sign-in page. Only for a demo database (npm run seed:demo).
DEMO_MODE=0

# 1 when people reach the portal over plain http on a private network (see docs/SELF_HOSTING.md)
PLAIN_HTTP=0

# Days a sign-in stays valid
SESSION_DAYS=14

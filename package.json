{
  "name": "kademe-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Kademe Yönetim Portalı: genel müdür yardımcısı, direktörler ve müdürler için proje, toplantı ve duyuru portalı.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "create-admin": "node scripts/create-admin.js",
    "seed:demo": "node scripts/seed-demo.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "express": "4.21.2",
    "helmet": "8.0.0",
    "pg": "8.13.1"
  }
}
